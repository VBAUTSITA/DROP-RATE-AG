<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.4.5</version>
		<relativePath/>
	</parent>

	<groupId>com.example</groupId>
	<artifactId>ran-parameter-copilot</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>ran-parameter-copilot</name>
	<description>Sales Zone Advisor - Commercial Team Chatbot</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>dev.langchain4j</groupId>
				<artifactId>langchain4j-bom</artifactId>
				<version>1.18.1</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>

		<!-- Spring Web - REST endpoints -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Spring Data JPA - repositories -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- PostgreSQL Driver (home setup) -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Oracle JDBC Driver (office setup). Both drivers can sit on the
		     classpath at once; Spring picks one from spring.datasource.url. -->
		<dependency>
			<groupId>com.oracle.database.jdbc</groupId>
			<artifactId>ojdbc11</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- LangChain4j core -->
		<dependency>
			<groupId>dev.langchain4j</groupId>
			<artifactId>langchain4j</artifactId>
		</dependency>

		<!-- LangChain4j Google AI Gemini (native protocol) — the ONLY LLM
		     provider on this branch.
		     langchain4j-open-ai is deliberately absent: this build runs on a
		     corporate network where outbound calls to public AI endpoints other
		     than Google's are not permitted. Leaving the OpenAI client off the
		     classpath makes such a call impossible rather than merely unlikely.
		     Do not add it back on this branch.
		     The native API (not Google's OpenAI-compatible endpoint) is required
		     for tool calling: it carries thought_signature, which the
		     OpenAI-compatible schema cannot represent. -->
		<dependency>
			<groupId>dev.langchain4j</groupId>
			<artifactId>langchain4j-google-ai-gemini</artifactId>
		</dependency>

<!-- langchain4j-spring-boot-starter is deliberately NOT declared.
		     Nothing here uses its autoconfiguration (no @AiService, no
		     langchain4j.* properties) — every bean is built explicitly in
		     ChatModelConfig / AiConfig / DropAgentConfig / RagConfig.
		     Its RagAutoConfig eagerly builds a ContentRetriever from the
		     EmbeddingStore bean, which fails with "embeddingStore cannot be
		     null" on Oracle, where RagConfig intentionally returns null
		     because pgvector is PostgreSQL-only. -->

		<!-- LangChain4j pgvector embedding store (RAG) -->
		<dependency>
			<groupId>dev.langchain4j</groupId>
			<artifactId>langchain4j-pgvector</artifactId>
		</dependency>

		<!-- Test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
