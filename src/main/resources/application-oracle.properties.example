spring.application.name=ran-parameter-copilot

# =========================================================================
# OFFICE SETUP — Oracle + Google Gemini
# =========================================================================
# Copy to application-oracle.properties (drop the .example), fill in your
# values, and run with the "oracle" profile:
#
#   mvnw.cmd spring-boot:run -Dspring-boot.run.profiles=oracle
#
# or add to application.properties:  spring.profiles.active=oracle
#
# The plain application.properties (PostgreSQL + OpenRouter) stays untouched,
# so the home setup keeps working from the same codebase.
# =========================================================================

# -----------------------------
# DATASOURCE (ORACLE)
# -----------------------------
# Service-name form (most common):
spring.datasource.url=jdbc:oracle:thin:@//host:1521/SERVICE_NAME
# SID form, if your DBA gave you a SID instead of a service name:
# spring.datasource.url=jdbc:oracle:thin:@host:1521:SID
spring.datasource.username=your_dev_schema
spring.datasource.password=your_password
spring.datasource.driver-class-name=oracle.jdbc.OracleDriver

# -----------------------------
# JPA / HIBERNATE
# -----------------------------
# Do NOT set spring.jpa.database-platform here. Hibernate 6 auto-detects the
# Oracle dialect from JDBC metadata; leaving PostgreSQLDialect in place makes
# Hibernate emit Postgres SQL against Oracle (ORA-00902 on create table).
#
# ddl-auto=update creates the tables in your dev schema on first start; it needs
# CREATE TABLE privilege plus tablespace quota. If the schema is locked down,
# have your DBA create the tables and switch this to "validate".
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.open-in-view=false

# -----------------------------
# LLM PROVIDER — Google Gemini (native API)
# -----------------------------
# provider=gemini selects GoogleAiGeminiChatModel, which speaks Gemini's native
# protocol. This is required for tool calling: Gemini "thinking" models (2.5+,
# 3.x) emit a thought_signature that must be echoed back on the next turn, and
# the OpenAI-compatible endpoint has no field to carry it — the tool loop then
# fails with "400 INVALID_ARGUMENT: Function call is missing a thought_signature".
llm.provider=gemini
llm.model=gemini-3.6-flash
llm.api-key=your_google_ai_studio_key
# Keep retries low on the free tier: each failed call is retried, and the
# per-minute quota is small (429 RESOURCE_EXHAUSTED).
llm.max-retries=2

# llm.base-url is not used by the gemini provider.

# -----------------------------
# CORPORATE PROXY
# -----------------------------
# Java ignores the Windows proxy settings that browsers and Python use, so
# outbound calls fail with "Connection timed out" until the JVM is told about
# the proxy. This is a JVM argument, not a property — add it to the launch
# configuration (VS Code .vscode/launch.json):
#
#   "vmArgs": "-Dhttps.proxyHost=your-proxy -Dhttps.proxyPort=80 -Dhttp.proxyHost=your-proxy -Dhttp.proxyPort=80 -Dhttp.nonProxyHosts=localhost|127.0.0.1"
#
# Find the proxy with:  python -c "import urllib.request;print(urllib.request.getproxies())"
# JDBC uses plain sockets and ignores these properties, so Oracle is unaffected.

# -----------------------------
# RAG / pgvector
# -----------------------------
# Not available on Oracle: PgVectorEmbeddingStore is PostgreSQL-only. RagConfig
# detects the non-PostgreSQL URL and disables the embedding store, logging
# "[RagConfig] Datasource is not PostgreSQL". The app starts normally and only
# getKnowledgeForCause reports the knowledge base as unavailable.
