spring.application.name=ran-parameter-copilot

# -----------------------------
# DATASOURCE (POSTGRESQL)
# -----------------------------
spring.datasource.url=jdbc:postgresql://localhost:5432/your_db
spring.datasource.username=your_username
spring.datasource.password=your_password
spring.datasource.driver-class-name=org.postgresql.Driver

# -----------------------------
# JPA / HIBERNATE
# -----------------------------
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.open-in-view=false

# -----------------------------
# IA - OpenRouter (OpenAI-compatible)
# -----------------------------
openai.api-key=your_openrouter_api_key

# -----------------------------
# PCI PLANNING BACKEND
# -----------------------------
# Which implementation of PciPlannerPort answers the PCI tools.
#
#   local  (default) — the seeded PCI mirror in this database. Detects collision /
#                      confusion / mod-3 and proposes a conflict-free PCI. It does NOT
#                      model RSI and does NOT weigh RF geometry; every answer says so.
#   rest             — the real multi-technology PCI/RSI planner over HTTP. It runs on
#                      JDK 8 (its engine needs Nashorn), so it cannot be called in-process.
#
# Switching backends changes no tool signature and no correlation rule.
pci.planner.backend=local

# Only read when pci.planner.backend=rest — see integration/tracker/README.md
#pci.planner.base-url=http://tracker.internal:8080
#pci.planner.api-key=
# The re-plan call runs the assignment engine over the surrounding network, so its read
# timeout is deliberately much longer than the connect timeout.
#pci.planner.connect-timeout-ms=3000
#pci.planner.read-timeout-ms=30000
